orms":["jugaba","jugabas","jugaba","jugábamos","jugaban"]},{"tense":"imperfect","group":"regular","inf":"bailar","en":"to dance","forms":["bailaba","bailabas","bailaba","bailábamos","bailaban"]},{"tense":"imperfect","group":"regular","inf":"trabajar","en":"to work","forms":["trabajaba","trabajabas","trabajaba","trabajábamos","trabajaban"]},{"tense":"imperfect","group":"regular","inf":"estudiar","en":"to study","forms":["estudiaba","estudiabas","estudiaba","estudiábamos","estudiaban"]},{"tense":"imperfect","group":"regular","inf":"estar","en":"to be","forms":["estaba","estabas","estaba","estábamos","estaban"]},{"tense":"imperfect","group":"regular","inf":"dar","en":"to give","forms":["daba","dabas","daba","dábamos","daban"]},{"tense":"imperfect","group":"regular","inf":"comer","en":"to eat","forms":["comía","comías","comía","comíamos","comían"]},{"tense":"imperfect","group":"regular","inf":"vivir","en":"to live","forms":["vivía","vivías","vivía","vivíamos","vivían"]},{"tense":"imperfect","group":"regular","inf":"tener","en":"to have","forms":["tenía","tenías","tenía","teníamos","tenían"]},{"tense":"imperfect","group":"regular","inf":"hacer","en":"to do, to make","forms":["hacía","hacías","hacía","hacíamos","hacían"]},{"tense":"imperfect","group":"regular","inf":"poder","en":"to be able to","forms":["podía","podías","podía","podíamos","podían"]},{"tense":"imperfect","group":"regular","inf":"querer","en":"to want","forms":["quería","querías","quería","queríamos","querían"]},{"tense":"imperfect","group":"regular","inf":"escribir","en":"to write","forms":["escribía","escribías","escribía","escribíamos","escribían"]},{"tense":"imperfect","group":"regular","inf":"salir","en":"to leave","forms":["salía","salías","salía","salíamos","salían"]},{"tense":"imperfect","group":"regular","inf":"dormir","en":"to sleep","forms":["dormía","dormías","dormía","dormíamos","dormían"]},{"tense":"imperfect","group":"regular","inf":"pedir","en":"to ask for, to order","forms":["pedía","pedías","pedía","pedíamos","pedían"]},{"tense":"imperfect","group":"regular","inf":"leer","en":"to read","forms":["leía","leías","leía","leíamos","leían"]},{"tense":"imperfect","group":"irregular","inf":"ser","en":"to be","forms":["era","eras","era","éramos","eran"]},{"tense":"imperfect","group":"irregular","inf":"ir","en":"to go","forms":["iba","ibas","iba","íbamos","iban"]},{"tense":"imperfect","group":"irregular","inf":"ver","en":"to see","forms":["veía","veías","veía","veíamos","veían"]}],"SENT":[{"s":"Ayer nosotros ____ (ir) al cine.","a":["fuimos"],"t":"preterite","why":"“Ayer” points to one completed event, so use the preterite."},{"s":"Cuando yo era niña, ____ (jugar) en el parque todos los días.","a":["jugaba"],"t":"imperfect","why":"A habit in the past (“todos los días”) takes the imperfect."},{"s":"Anoche ellos ____ (hacer) la tarea.","a":["hicieron"],"t":"preterite","why":"“Anoche” marks a completed action."},{"s":"La semana pasada tú ____ (ver) una película de terror.","a":["viste"],"t":"preterite","why":"A single finished event last week: preterite. Ver has no accent in viste."},{"s":"Todos los veranos nosotros ____ (viajar) a México.","a":["viajábamos"],"t":"imperfect","why":"“Todos los veranos” signals repeated past action. The nosotros form needs the accent on ába."},{"s":"De repente, el teléfono ____ (sonar).","a":["sonó"],"t":"preterite","why":"“De repente” interrupts the scene with a sudden, completed event."},{"s":"Ayer Ana ____ (pedir) una ensalada.","a":["pidió"],"t":"preterite","why":"Completed action. Pedir is an -ir stem changer: e→i in the él/ella form."},{"s":"Mi hermano ____ (ser) muy travieso cuando era pequeño.","a":["era"],"t":"imperfect","why":"Describing how someone used to be: imperfect."},{"s":"El año pasado mi familia ____ (estar) en Madrid.","a":["estuvo"],"t":"preterite","why":"A completed stay with a time frame (“el año pasado”): preterite. Estar uses the irregular stem estuv-."},{"s":"Todos los sábados yo ____ (ir) al mercado con mi abuela.","a":["iba"],"t":"imperfect","why":"“Todos los sábados” signals a habit: imperfect of ir."},{"s":"Anoche yo ____ (dormir) ocho horas.","a":["dormí"],"t":"preterite","why":"Completed action with a stated amount of time: preterite."},{"s":"Ayer los chicos ____ (decir) la verdad.","a":["dijeron"],"t":"preterite","why":"Decir has the stem dij-, and a j stem takes -eron, not -ieron."},{"s":"Mientras tú ____ (estudiar), yo preparaba la cena.","a":["estudiabas"],"t":"imperfect","why":"“Mientras” introduces an ongoing action: imperfect."},{"s":"Ayer tú ____ (leer) un libro entero.","a":["leíste"],"t":"preterite","why":"Leer is a spelling-change verb. The tú form is leíste, with an accent on the í."},{"s":"Cuando éramos jóvenes, nosotros ____ (vivir) en Chile.","a":["vivíamos"],"t":"imperfect","why":"Describing past circumstances with no clear end: imperfect."},{"s":"Anoche ella ____ (poner) la mesa antes de la cena.","a":["puso"],"t":"preterite","why":"Completed action. Poner uses the irregular stem pus-, and the él/ella ending is -o."},{"s":"El sábado pasado yo ____ (buscar) mis llaves por una hora.","a":["busqué"],"t":"preterite","why":"Completed action. The yo form of -car verbs changes c→qu."},{"s":"Ellos siempre ____ (comer) en casa de sus abuelos.","a":["comían"],"t":"imperfect","why":"“Siempre” signals a repeated past habit."},{"s":"Hace dos días Luis ____ (tener) que estudiar.","a":["tuvo"],"t":"preterite","why":"“Hace dos días” frames a completed event. Tener uses the stem tuv-."},{"s":"Ayer yo ____ (venir) a la escuela en autobús.","a":["vine"],"t":"preterite","why":"Completed action. Venir uses the stem vin- and the yo ending -e, with no accent."},{"s":"Cuando éramos niños, nosotros ____ (ir) a la playa cada domingo.","a":["íbamos"],"t":"imperfect","why":"“Cada domingo” is a habit. Ir is irregular in the imperfect, and nosotros needs the accent on í."},{"s":"Esta mañana yo ____ (dar) un regalo a mi madre.","a":["di"],"t":"preterite","why":"Completed action. Dar takes -er/-ir preterite endings with no accent: di."},{"s":"Mi hermano ____ (dormir) mucho los fines de semana.","a":["duerme"],"t":"present","why":"Present habit. Dormir is a boot verb (o→ue) in the él/ella form."},{"s":"Yo ____ (hacer) la tarea todas las noches.","a":["hago"],"t":"present","why":"Present tense. Hacer is a yo-go verb."},{"s":"Nosotros ____ (pedir) pizza todos los viernes.","a":["pedimos"],"t":"present","why":"Nosotros keeps the original stem in the present: pedimos, not pidimos."},{"s":"Ellos no ____ (poder) venir hoy.","a":["pueden"],"t":"present","why":"“Hoy” points to now. Poder is a boot verb (o→ue) and ellos is in the boot."},{"s":"Ahora mismo tú ____ (querer) comer algo, ¿verdad?","a":["quieres"],"t":"present","why":"Present tense. Querer is a boot verb (e→ie) in the tú form."}]}